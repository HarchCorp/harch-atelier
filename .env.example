# ─── ATELIER DATABASE (PostgreSQL) ───────────────────────────────
# Production: Neon / Supabase / Railway
# Local dev:  Neon free tier recommended (https://neon.tech)
#
# Copy this file to .env and fill in your real DATABASE_URL + DIRECT_URL
# Then run: bunx prisma generate && bunx prisma db push

DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/harch_atelier?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/harch_atelier?sslmode=require"

# ─── AI ──────────────────────────────────────────────────────────
# GLM-4 via Z.ai SDK — server-side only, NEVER expose in client code
ZAI_API_KEY=""

# ─── AUTH ────────────────────────────────────────────────────────
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── WHATSAPP (Twilio) ───────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ─── EMAIL (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="atelier@harchcorp.com"

# ─── REDIS (BullMQ) ──────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
