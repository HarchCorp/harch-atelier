// ═══════════════════════════════════════════════════════════════
//  HARCH ATELIER — PRISMA SCHEMA v4.1 (Raw Intelligence Export)
//  Neon PostgreSQL — Clean schema, no advisory models
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── CORE ENTITIES ──────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  aliases        String[]
  sector         String
  ticker         String?
  foundedYear    Int?
  headquarters   String?
  website        String?
  description    String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  articles         Article[]
  sentimentScores  SentimentScore[]
  riskAssessments  RiskAssessment[]
  reputationScores ReputationScore[]
  aiVisibility     AIVisibility[]
  entities         EntityMention[]
}

model Article {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  url           String   @unique
  source        String
  sourceId      String?
  publishedAt   DateTime?
  scrapedAt     DateTime @default(now())
  content       String?
  summary       String?
  language      String?
  sentimentLabel String?
  sentimentScore Float?
  relevanceScore Float?
  urlHash       String   @unique
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([companyId, publishedAt])
  @@index([source])
  @@index([sentimentLabel])
  @@index([processed])
}

// ─── ANALYTICS ──────────────────────────────────────────────────

model SentimentScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score         Float
  positivePct   Float
  neutralPct    Float
  negativePct   Float
  articleCount  Int
  language      String?
  sourceBreakdown Json?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, calculatedAt])
}

model RiskAssessment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overallRisk   Float
  riskLevel     String
  category      String
  frequency     Float?
  impactSeverity Float?
  velocity      Float?
  riskScore     Float
  trajectory    String?
  articleCount  Int?
  assessedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, assessedAt])
  @@index([riskLevel])
  @@index([category])
}

model ReputationScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overall       Float
  sentiment     Float?
  aiVisibility  Float?
  volume        Float?
  authority     Float?
  innovationScore Float?
  innovationWeight Float?
  performanceScore Float?
  performanceWeight Float?
  purposeScore  Float?
  purposeWeight Float?
  shareOfVoice  Float?
  trend         String?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, calculatedAt])
}

model AIVisibility {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      String
  cited         Boolean
  position      String?
  sentiment     String?
  confidence    Float?
  summary       String?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, platform])
  @@index([companyId, checkedAt])
}

// ─── ENTITY GRAPH ───────────────────────────────────────────────

model Entity {
  id            String   @id @default(cuid())
  entityType    String
  name          String
  aliases       String[]
  confidence    Float    @default(0.5)
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  sources       String[]
  tags          String[]
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mentions      EntityMention[]

  @@index([entityType])
  @@index([name])
}

model EntityMention {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  articleId     String?
  mentionText   String
  sentimentLabel String?
  sentimentScore Float?
  mentionedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([entityId])
  @@index([companyId])
}

// ─── GLM CACHE (24h TTL strict) ─────────────────────────────────

model GLMAnalysis {
  id            String   @id @default(cuid())
  inputHash     String   @unique
  model         String
  promptType    String
  inputPayload  Json
  outputPayload Json
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  @@index([inputHash])
  @@index([promptType])
  @@index([createdAt])
}

// ─── JOBS & LOGGING ─────────────────────────────────────────────

model Job {
  id            String   @id @default(cuid())
  jobType       String
  status        String   @default("pending")
  payload       Json?
  result        Json?
  error         String?
  progress      Int      @default(0)
  scheduledAt   DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobType, status])
  @@index([status])
}

model ScraperLog {
  id            String   @id @default(cuid())
  sourceId      String
  sourceName    String
  sourceUrl     String
  status        String
  articlesFound Int      @default(0)
  articlesNew   Int      @default(0)
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([sourceId, startedAt])
  @@index([status])
}

model SystemLog {
  id            String   @id @default(cuid())
  level         String
  category      String
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([level, createdAt])
  @@index([category])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  resource      String
  ipAddress     String?
  userAgent     String?
  result        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ─── AUTH ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("user")
  plan          String   @default("free")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  apiKeys       ApiKey[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken  String   @unique
  expires       DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash       String   @unique
  name          String
  tier          String   @default("pro")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([keyHash])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ACCESS REQUESTS (public form submissions) ──────────────────
// People who want access to the Console fill a public form.
// Admin reviews and creates invitations from these requests.

model AccessRequest {
  id        String   @id @default(cuid())
  email     String
  name      String
  company   String?
  role      String?  // e.g. "Comms Director", "CEO", "Analyst"
  message   String?
  status    String   @default("pending")  // pending | accepted | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When accepted, link to the invitation created from this request
  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ─── INVITATIONS (admin-created access links) ───────────────────
// Admin creates an invitation with a pre-set password.
// The invitation link is sent to the user. When they visit it,
// they see their pre-filled info and can sign in immediately.

model Invitation {
  id        String    @id @default(cuid())
  token     String    @unique  // URL token for /atelier/access?token=XXX
  email     String
  name      String
  password  String    // pre-generated by admin (user can change later)
  plan      String    @default("decouverte")  // decouverte | veille | investor
  role      String    @default("user")  // user | admin
  company   String?
  message   String?   // optional personal message from admin
  createdById String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?  // null until user accepts
  acceptedById String?  // the User.id created from this invitation

  accessRequests AccessRequest[]

  @@index([token])
  @@index([email])
  @@index([createdAt])
}
