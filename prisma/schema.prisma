// ═══════════════════════════════════════════════════════════════
//  HARCH ATELIER — PRISMA SCHEMA v4.1 (Raw Intelligence Export)
//  Neon PostgreSQL — Clean schema, no advisory models
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── CORE ENTITIES ──────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  aliases        String[]
  sector         String
  ticker         String?
  foundedYear    Int?
  headquarters   String?
  website        String?
  description    String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  articles         Article[]
  sentimentScores  SentimentScore[]
  riskAssessments  RiskAssessment[]
  reputationScores ReputationScore[]
  aiVisibility     AIVisibility[]
  entities         EntityMention[]
  assets           Asset[]           // link: Company → listed Asset(s)
  portfolioHoldings PortfolioHolding[]
  dossiers         Dossier[]
  reports          Report[]
  briefings        Briefing[]
}

model Article {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  url           String   @unique
  source        String
  sourceId      String?
  publishedAt   DateTime?
  scrapedAt     DateTime @default(now())
  content       String?
  summary       String?
  language      String?
  sentimentLabel String?
  sentimentScore Float?
  relevanceScore Float?
  urlHash       String   @unique
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([companyId, publishedAt])
  @@index([source])
  @@index([sentimentLabel])
  @@index([processed])
}

// ─── ANALYTICS ──────────────────────────────────────────────────

model SentimentScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score         Float
  positivePct   Float
  neutralPct    Float
  negativePct   Float
  articleCount  Int
  language      String?
  sourceBreakdown Json?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, calculatedAt])
}

model RiskAssessment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overallRisk   Float
  riskLevel     String
  category      String
  frequency     Float?
  impactSeverity Float?
  velocity      Float?
  riskScore     Float
  trajectory    String?
  articleCount  Int?
  assessedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, assessedAt])
  @@index([riskLevel])
  @@index([category])
}

model ReputationScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overall       Float
  sentiment     Float?
  aiVisibility  Float?
  volume        Float?
  authority     Float?
  innovationScore Float?
  innovationWeight Float?
  performanceScore Float?
  performanceWeight Float?
  purposeScore  Float?
  purposeWeight Float?
  shareOfVoice  Float?
  trend         String?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([companyId, calculatedAt])
}

model AIVisibility {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      String
  cited         Boolean
  position      String?
  sentiment     String?
  confidence    Float?
  summary       String?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  // ─── REAL AI PROBING (Task: ai-visibility-real) ───────────────
  // One row per (engine × probe query). A single probe run produces
  // 10 queries × 8 engines = 80 rows grouped by `batchId`.
  query           String?  // The probe query that was sent to the engine
  rank            Int?     // 1-based position where the company was first mentioned (null when not mentioned)
  mentions        Int?     // Count of company-name occurrences in the response
  shareOfVoice    Float?   // 0-100 — share of the response that is about this company
  simulated       Boolean  @default(false) // true when the engine is simulated via prompt variation (labeled in UI)
  responseExcerpt String?  // Short excerpt (~240 chars) of the LLM response
  sentimentScore  Float?   // -1 (very negative) to 1 (very positive)
  batchId         String?  // Groups all 80 rows from a single probe run (cuid-based)

  @@index([companyId, platform])
  @@index([companyId, checkedAt])
  @@index([companyId, batchId])
  @@index([batchId, platform])
}

// ─── ENTITY GRAPH ───────────────────────────────────────────────

model Entity {
  id            String   @id @default(cuid())
  entityType    String
  name          String
  aliases       String[]
  confidence    Float    @default(0.5)
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  sources       String[]
  tags          String[]
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mentions      EntityMention[]

  @@index([entityType])
  @@index([name])
}

model EntityMention {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  articleId     String?
  mentionText   String
  sentimentLabel String?
  sentimentScore Float?
  mentionedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([entityId])
  @@index([companyId])
}

// ─── GLM CACHE (24h TTL strict) ─────────────────────────────────

model GLMAnalysis {
  id            String   @id @default(cuid())
  inputHash     String   @unique
  model         String
  promptType    String
  inputPayload  Json
  outputPayload Json
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  @@index([inputHash])
  @@index([promptType])
  @@index([createdAt])
}

// ─── JOBS & LOGGING ─────────────────────────────────────────────

model Job {
  id            String   @id @default(cuid())
  jobType       String
  status        String   @default("pending")
  payload       Json?
  result        Json?
  error         String?
  progress      Int      @default(0)
  scheduledAt   DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobType, status])
  @@index([status])
}

model ScraperLog {
  id            String   @id @default(cuid())
  sourceId      String
  sourceName    String
  sourceUrl     String
  status        String
  articlesFound Int      @default(0)
  articlesNew   Int      @default(0)
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([sourceId, startedAt])
  @@index([status])
}

model SystemLog {
  id            String   @id @default(cuid())
  level         String
  category      String
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([level, createdAt])
  @@index([category])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  resource      String
  ipAddress     String?
  userAgent     String?
  result        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ─── AUTH ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("user")        // user | admin
  accountType   String   @default("brand-monitor") // brand-monitor | market-competitor | investment-bank | harch-alpha (ISOLATED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── WhatsApp alerts (Twilio) ────────────────────────────────────
  // whatsappNumber: E.164 format phone (e.g. +212600000000). NULL = unset.
  // whatsappAlerts: master toggle for the user.
  // alertSeverityThreshold: minimum severity that triggers a WhatsApp push.
  whatsappNumber          String?  // E.164 format: +212600000000
  whatsappAlerts          Boolean  @default(false)
  alertSeverityThreshold  String   @default("high") // low | medium | high | critical

  sessions      Session[]
  apiKeys       ApiKey[]
  accounts      Account[]
  portfolios    Portfolio[]
  dossiers      Dossier[]
  reports       Report[]
  briefings     Briefing[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken  String   @unique
  expires       DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash       String   @unique
  name          String
  tier          String   @default("pro")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([keyHash])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ACCESS REQUESTS (public form submissions) ──────────────────
// People who want access to the Console fill a public form.
// Admin reviews and creates invitations from these requests.

model AccessRequest {
  id            String   @id @default(cuid())
  email         String
  name          String
  company       String?
  role          String?
  accountType   String?  @default("brand-monitor") // brand-monitor | market-competitor | investment-bank | harch-alpha
  companySize   String?  // startup | sme | mid-market | enterprise
  useCase       String?  // what they want to monitor
  budget        String?  // monthly budget range
  phone         String?  // for WhatsApp
  country       String?  // default: Morocco
  referralSource String? // how they heard about us
  message       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ─── INVITATIONS (admin-created access links) ───────────────────
// Admin creates an invitation with a pre-set password.
// The invitation link is sent to the user. When they visit it,
// they see their pre-filled info and can sign in immediately.

model Invitation {
  id            String    @id @default(cuid())
  token         String    @unique  // URL token for /atelier/access?token=XXX
  email         String
  name          String
  passwordHash  String    // bcrypt hash of admin-generated password (NEVER plaintext)
  accountType   String    @default("brand-monitor")  // brand-monitor | market-competitor | investment-bank | harch-alpha
  role          String    @default("user")        // user | admin
  company       String?
  message       String?   // optional personal message from admin
  createdById   String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?  // null until user accepts
  acceptedById  String?  // the User.id created from this invitation

  accessRequests AccessRequest[]

  @@index([token])
  @@index([email])
  @@index([createdAt])
}

// ─── TRADER MODELS (Asset, AssetPrice, AssetSentiment) ──────────
// Traders monitor ASSETS (stocks, crypto, commodities, FX), not
// companies. The same Article pipeline feeds both: an article about
// OCP feeds Company.reputationScore (enterprise) AND Asset.sentiment
// (trader) via the company.ticker → Asset.ticker link.

model Asset {
  id          String   @id @default(cuid())
  ticker      String   @unique  // e.g. "OCP", "ATW", "IAM", "BTC", "EURUSD"
  name        String
  assetType   String   // stock | crypto | commodity | fx | index
  exchange    String?  // e.g. "BVC" (Bourse de Casablanca), "BINANCE"
  companyId   String?  // link to Company if asset is a listed stock
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices      AssetPrice[]
  sentiments  AssetSentiment[]
  portfolioHoldings PortfolioHolding[]

  @@index([assetType])
  @@index([exchange])
}

model AssetPrice {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price       Float
  volume      Float?
  changePct   Float?   // % change vs previous close
  tradedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([assetId, tradedAt])
}

model AssetSentiment {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  score         Float    // -1 to 1 (sentiment)
  positivePct   Float
  neutralPct    Float
  negativePct   Float
  articleCount  Int
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([assetId, calculatedAt])
}

// ─── INVESTOR MODELS (Portfolio, PortfolioHolding, Dossier) ─────
// Investors track multiple PORTFOLIOS of companies/assets and run
// due diligence DOSSIERS on targets. ESG + Controversy screening
// is built on top of RiskAssessment (already exists).

model Portfolio {
  id          String   @id @default(cuid())
  name        String   // e.g. "Fund VI", "ESG Fund", "Co-invest Pool"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holdings    PortfolioHolding[]

  @@index([userId])
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  companyId   String?  // optional link to Company
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assetId     String?  // optional link to Asset
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  weight      Float    // portfolio weight (0-1)
  addedAt     DateTime @default(now())

  @@index([portfolioId])
}

model Dossier {
  id          String   @id @default(cuid())
  title       String   // e.g. "OCP Group — DD Q3 2026"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?  // the target company being investigated
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      String   @default("draft")  // draft | generating | ready | archived
  pdfUrl      String?  // generated PDF URL
  pageCount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ─── MONTHLY REPORTS (PDF) ──────────────────────────────────────
// Generated on the 1st of each month by /api/cron/generate-reports.
// `sections` is a JSON blob with the structured data that feeds the
// ReportPDF document (executive summary, sentiment, AI visibility,
// alerts log, recommendations). One Report per (userId, period).

model Report {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?  // optional link to the primary Company the report covers
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title       String   // e.g. "Monthly Intelligence Report"
  period      String   // e.g. "2026-07" (YYYY-MM)
  summary     String   // 1-2 paragraph executive summary
  sections    Json     // structured data: { metrics, alerts, aiEngines, recommendations, sentimentTrend, sources }
  status      String   @default("ready")  // draft | generating | ready | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId, createdAt])
  @@index([period])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────
// Per-user notifications generated by cron jobs (alert scanner,
// report generator, threshold breaches) and surfaced in the
// ConsoleShell top-bar bell dropdown.

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // alert | report | system | threshold
  title     String
  body      String
  severity  String   @default("info") // info | warning | critical
  read      Boolean  @default(false)
  link      String?  // URL to navigate to
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

// ─── DAILY AI BRIEFINGS ───────────────────────────────────────────
// Generated each morning by /api/cron/generate-briefings (07:00 UTC).
// One row per (userId, date). The LLM is prompted with the last 24h of
// alerts/topics/ai-visibility/neighbors and returns a structured
// briefing with cited REAL alert IDs (no hallucinated sources — the
// API maps the LLM's alertIndex back to actual Article/RiskAssessment
// ids before persisting). The Console fetches the cached row by date
// and falls back to on-demand generation if missing.
//
// `sections` JSON shape mirrors what the /api/console/briefing route
// returns on the wire:
//   {
//     executiveSummary: string,
//     topThreats:       [{ title, alertId, alertIndex, reason, source, url, severity }],
//     topOpportunities: [{ title, alertId, alertIndex, reason, source, url, severity }],
//     sentimentShift:   string,
//     recommendedActions: string[],
//     citedAlertIds:    string[],
//     sources:          [{ id, title, source, url, severity, publishedAt }]
//   }

model Briefing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  date        String   // YYYY-MM-DD (Casablanca local day the briefing covers)
  title       String   // e.g. "Daily Intelligence Briefing — 2026-07-31"
  summary     String   // 2-3 sentence executive summary (also stored in sections.executiveSummary)
  sections    Json     // structured briefing payload (see comment above)
  model       String?  // LLM model used (e.g. "glm-4")
  alertCount  Int      // number of alerts fed to the LLM
  citedCount  Int      // number of real alerts cited
  status      String   @default("ready") // draft | generating | ready | failed
  error       String?  // populated when status = "failed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@index([date])
}

// ─── INFLUENCER DATABASE (Klear / Meltwater-style) ────────────────
// Curated directory of Moroccan journalists, editors, analysts and
// content creators across press / Twitter-X / LinkedIn / YouTube /
// TikTok / Instagram. Each profile carries composite influence
// metrics (reach / engagement / authority) plus a 30-day mention
// history (InfluencerMention) — surfaced in the Brand Monitor
// console under "Influencers DB".

model Influencer {
  id              String   @id @default(cuid())
  name            String
  handle          String?  // @username on the platform
  platform        String   // twitter | linkedin | instagram | youtube | tiktok | press
  bio             String?
  followers       Int      @default(0)
  following       Int      @default(0)
  verified        Boolean  @default(false)
  location        String?  // Casablanca, Rabat, etc.
  languages       String   @default("[]") // JSON array of language codes
  topics          String   @default("[]") // JSON array of topic labels
  reachScore      Int      @default(0)    // 0-100
  engagementScore Int      @default(0)    // 0-100
  authorityScore  Int      @default(0)    // 0-100
  influenceScore  Int      @default(0)    // composite 0-100
  lastAnalyzed    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentions        InfluencerMention[]

  @@index([platform, influenceScore])
  @@index([location])
}

model InfluencerMention {
  id           String   @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  alertId      String?  // link to the alert/article if applicable
  title        String
  url          String?
  sentiment    String   @default("neutral") // positive | neutral | negative
  reach        Int      @default(0)
  publishedAt  DateTime
  createdAt    DateTime @default(now())

  @@index([influencerId, publishedAt])
}
