// ═══════════════════════════════════════════════════════════════
//  HARCH ATELIER — PRISMA SCHEMA v4.1 (Raw Intelligence Export)
//  Neon PostgreSQL — Clean schema, no advisory models
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── CORE ENTITIES ──────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  aliases        String[]
  sector         String
  ticker         String?
  foundedYear    Int?
  headquarters   String?
  website        String?
  description    String?
  logoUrl        String?
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  // domain: official website domain used for self-registration matching.
  // When a user signs up with med.alami@attijariwafa.com, we extract
  // "attijariwafa.com" and look it up here. NULL for companies that
  // haven't been onboarded via the self-service flow yet.
  // isDemo: true for companies created by the executive demo seed
  // (Brand Monitor / Market Competitor demo competitors). Real users
  // never see demo companies, demo users never see real companies.
  domain         String?  @unique  // Official website domain (e.g. attijariwafa.com)
  isDemo         Boolean  @default(false)

  // ─── Task: company-dedup-enterprise-admin ─────────────────────────
  // ICE = Identifiant Commun de l'Entreprise (Morocco tax id, 15 digits).
  // RC  = Registre de Commerce (Morocco trade register number).
  // Both are optional but ICE is unique when provided (primary dedup key).
  // parentId links a subsidiary to its parent company (self-referential).
  iceNumber      String?  // Identifiant Commun de l'Entreprise (Morocco)
  rcNumber       String?  // Registre de Commerce number
  parentId       String?  // for subsidiaries (parent company)
  parent         Company? @relation("CompanyHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subsidiaries   Company[] @relation("CompanyHierarchy")

  articles         Article[]
  sentimentScores  SentimentScore[]
  riskAssessments  RiskAssessment[]
  reputationScores ReputationScore[]
  aiVisibility     AIVisibility[]
  entities         EntityMention[]
  assets           Asset[]           // link: Company → listed Asset(s)
  portfolioHoldings PortfolioHolding[]
  dossiers         Dossier[]
  reports          Report[]
  briefings        Briefing[]
  users            User[]
  invitations      Invitation[]
  settings         CompanySettings?
  webhooks         Webhook[]

  // ─── Agency white-label relation (Brique 8) ───────────────────
  agencyClients    AgencyClient[]

  @@unique([iceNumber]) // ICE must be unique if provided
  @@index([sector])
  @@index([parentId])
  @@index([isDemo])
}

model Article {
  id            String   @id @default(cuid())
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title         String
  url           String   @unique
  source        String
  sourceId      String?
  publishedAt   DateTime?
  scrapedAt     DateTime @default(now())
  content       String?
  summary       String?
  language      String?
  sentimentLabel String?
  sentimentScore Float?
  relevanceScore Float?
  urlHash       String   @unique
  processed     Boolean  @default(false)
  tenantId      String?
  createdAt     DateTime @default(now())

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  // isDemo: true when this article was created by the executive demo
  // seed (Brand Monitor demo alerts, Market Competitor demo articles).
  // Real users filter isDemo:false in every console query so demo
  // alerts never pollute a real company's reputation console.
  isDemo        Boolean  @default(false)

  // ─── Task: signal-regulatory-feed ──────────────────────────────────
  // sourceType discriminates between regular media articles and the
  // dedicated regulatory feed (AMMC / BAM / BVC press releases scraped
  // daily by /api/cron/scrape-regulatory).
  //   • "media"        — default — generic news / RSS feed articles.
  //   • "regulatory"   — AMMC / BAM / BVC press release / circular.
  //   • "market"       — BVC listing notice / corporate action.
  //   • "financial"    — BAM monetary policy / banking regulation.
  // Older rows (inserted before this field existed) default to "media".
  sourceType    String   @default("media")

  @@index([companyId, publishedAt])
  @@index([companyId, sentimentLabel])
  @@index([source])
  @@index([sentimentLabel])
  @@index([processed])
  @@index([isDemo])
  @@index([sourceType])

  // ─── Task: BRICK-1-hespress ───────────────────────────────────────
  // ArticleComment — one row per scraped Hespress comment (or any other
  // WordPress-backed comment system we add later). Linked back to the
  // parent Article via articleId. Sentiment + language are pre-computed
  // at scrape time so the demo console can render a 2,000-comment thread
  // without re-running the NLP on every page load.
  comments      ArticleComment[]
}

// ─── ARTICLE COMMENTS (Hespress + future WP-backed sources) ────
//
//  Task ID: BRICK-1-hespress
//  Why: Hespress is the highest-reach Moroccan digital news outlet
//  (47-52% weekly reach per Reuters Institute 2025). Its comments
//  section is the richest source of Darija sentiment on the Moroccan
//  web — 200-2,000 anonymous comments per article. This model stores
//  every scraped comment alongside its pre-computed sentiment + language
//  label so the Brand Monitor can surface "Darija sentiment per article"
//  without re-running the NLP at view time.
//
//  Threading: Hespress supports nested replies (parent → child).
//  `parentId` is the original Hespress comment ID of the parent (not
//  our internal cuid). 0 / null = top-level comment.
//
//  IMPORTANT: prisma db push is NOT run — the sandbox DB has a known
//  SQLite/PostgreSQL mismatch (worklog §2, §6, §9). The model is added
//  to the schema so it materialises the moment a real PostgreSQL is
//  provisioned. The Hespress scraper + API + demo page work without
//  this table (they return the scraped comments directly), so the
//  demo is functional even with the DB still broken.

model ArticleComment {
  id                String   @id @default(cuid())
  articleId         String
  // Original Hespress (or WP) comment ID — the numeric ID from the WP
  // REST API `id` field. Used for threading (parentId) + dedup.
  commentId         String
  author            String?
  content           String
  publishedAt       DateTime?
  parentId          String?
  likes             Int      @default(0)
  // darija | arabic | french | mixed — from the Darija NLP detector.
  language          String
  // positive | negative | neutral — from the resilience sentiment analyzer.
  sentimentPolarity String
  // -1.0 .. +1.0 — from the resilience sentiment analyzer.
  sentimentScore    Float
  sarcasmDetected   Boolean  @default(false)
  scrapedAt         DateTime @default(now())

  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, commentId]) // prevent duplicate imports
  @@index([articleId])
  @@index([sentimentPolarity])
  @@index([language])
}

// ─── INBOUND WHATSAPP MESSAGES (the IKEA loop) ──────────────────
//
//  Task ID: BRICK-2-whatsapp-inbound
//  Why: The Dircom forwards a WhatsApp message (screenshot, link, or
//  text) from a group they're worried about. Harch's NLP pipeline
//  analyzes it and returns a risk assessment. This model persists
//  every inbound message + its analysis so the Dircom builds a
//  historical archive of "what I flagged and when".
//
//  Lifecycle: received → analyzing → responded | flagged
//  Crisis score: 0-100, computed from sentiment + injection + fakeness
//  + crisis keywords. >= 70 = critical (flagged, Comex escalation).

model InboundWhatsAppMessage {
  id                String   @id @default(cuid())
  fromPhone         String   // sender phone (E.164)
  fromName          String?  // ProfileName from Twilio
  body              String   // message text (or "[BLOCKED ...]" for injections)
  mediaUrl          String?  // image/audio/video URL (Twilio-hosted)
  mediaContentType  String?  // image/jpeg, audio/ogg, etc.
  receivedAt        DateTime @default(now())

  // NLP analysis (run by inbound-pipeline.ts)
  sentimentPolarity String   // positive | negative | neutral
  sentimentScore    Float
  sarcasmDetected   Boolean  @default(false)
  injectionDetected Boolean  @default(false)
  injectionPatterns String?  // JSON-encoded array of {label, match}
  fakenessScore     Float    @default(0)
  fakenessVerdict   String   @default("low") // low | medium | high
  crisisScore       Int      @default(0)     // 0-100
  language          String   // darija | arabic | french | mixed | english

  // Lifecycle
  status            String   @default("received") // received | analyzing | responded | flagged
  outboundBody      String?  // the WhatsApp reply we sent back
  respondedAt       DateTime?

  @@index([fromPhone])
  @@index([status])
  @@index([crisisScore])
  @@index([receivedAt])
}

// ─── AGENCY WHITE-LABEL ENGINE (Brique 8) ───────────────────────
//
//  Task ID: BRICK-8-agency
//  Why: PR/comms agencies (Omocto, PRESMA, Webcom, Blue Lions) are
//  prescripteurs, not direct buyers. They resell Harch under their
//  brand to their Dircom clients. This engine provides:
//    • Multi-tenant isolation (agency_id scoping on all queries)
//    • White-label branding (logo, colors, subdomain per sub-client)
//    • Quota allocation (requests, WhatsApp alerts, keywords)
//
//  Architecture:
//    Agency (master account) → has many AgencyClients (sub-clients)
//    AgencyClient → maps to one Company (existing model)
//    AgencyClient → has one AgencyBranding (logo, colors, subdomain)
//    AgencyClient → has one AgencyQuota (limits + current usage)
//    AgencyAdmin (User with role="agency-admin") → can switch between
//      sub-client workspaces via a session-scoped activeAgencyClientId

model Agency {
  id              String   @id @default(cuid())
  name            String   // e.g. "Omocto"
  slug            String   @unique // e.g. "omocto"
  legalName       String?  // e.g. "Omocto SARL"
  contactEmail    String?  // agency contact email
  contactPhone    String?
  website         String?
  // Commission: 30% revenue share (configurable per agency)
  commissionPct   Float    @default(30)
  // Agency-level branding (applied to the agency's own portal, not sub-clients)
  logoUrl         String?
  primaryColor    String?  // hex, e.g. "#4A7B5F"
  // Status
  status          String   @default("active") // active | suspended | terminated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clients         AgencyClient[]
  admins          User[]   @relation("AgencyAdmins")

  @@index([status])
}

model AgencyClient {
  id              String   @id @default(cuid())
  agencyId        String
  agency          Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  // The actual Company this sub-client manages (OCP, Attijariwafa, etc.)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Display name (may differ from Company.name — agency might use a codename)
  displayName     String

  // Subdomain for white-label access: iq.{subdomain}.harchcorp.com
  // or custom domain: iq.{client-domain}.com
  subdomain       String?  @unique
  customDomain    String?  @unique

  // Status
  status          String   @default("active") // active | suspended | terminated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branding        AgencyBranding?
  quota           AgencyQuota?
  usage           AgencyUsage[]

  @@unique([agencyId, companyId])
  @@index([agencyId])
  @@index([companyId])
  @@index([status])
}

model AgencyBranding {
  id              String   @id @default(cuid())
  agencyClientId  String   @unique
  agencyClient    AgencyClient @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)

  // Visual identity
  logoUrl         String?  // custom logo URL (overrides Harch default)
  primaryColor    String?  @default("#0A0A0A") // hex
  accentColor     String?  @default("#10b981") // hex
  fontFamily      String?  @default("'Inter', system-ui, sans-serif")
  faviconUrl      String?

  // Custom copy
  loginTitle      String?  @default("HarchIQ Console")
  loginSubtitle   String?
  footerText      String?

  // Hide Harch branding?
  hideHarchBadge  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgencyQuota {
  id              String   @id @default(cuid())
  agencyClientId  String   @unique
  agencyClient    AgencyClient @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)

  // Limits (reset monthly)
  maxApiRequests      Int   @default(10000)  // per month
  maxWhatsAppAlerts   Int   @default(100)    // per month
  maxKeywords         Int   @default(50)     // concurrent tracked keywords
  maxSources          Int   @default(30)     // concurrent monitored sources
  maxUsers            Int   @default(5)      // seats

  // Billing
  planTier            String @default("emergence") // emergence | corporate | sovereign
  monthlyPriceMAD     Int    @default(15000)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AgencyUsage {
  id              String   @id @default(cuid())
  agencyClientId  String
  agencyClient    AgencyClient @relation(fields: [agencyClientId], references: [id], onDelete: Cascade)

  // Usage period (monthly: "2026-08" format)
  period          String   // e.g. "2026-08"

  // Counters
  apiRequests     Int      @default(0)
  whatsappAlerts  Int      @default(0)
  keywordsUsed    Int      @default(0)
  sourcesUsed     Int      @default(0)
  usersActive     Int      @default(0)

  // Rolling counters (incremented in real-time, reset on billing cycle)
  lastResetAt     DateTime @default(now())

  @@unique([agencyClientId, period])
  @@index([agencyClientId])
  @@index([period])
}

// ─── ANALYTICS ──────────────────────────────────────────────────

model SentimentScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  score         Float
  positivePct   Float
  neutralPct    Float
  negativePct   Float
  articleCount  Int
  language      String?
  sourceBreakdown Json?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo        Boolean  @default(false)

  @@index([companyId, calculatedAt])
  @@index([isDemo])
}

model RiskAssessment {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overallRisk   Float
  riskLevel     String
  category      String
  frequency     Float?
  impactSeverity Float?
  velocity      Float?
  riskScore     Float
  trajectory    String?
  articleCount  Int?
  assessedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo        Boolean  @default(false)

  @@index([companyId, assessedAt])
  @@index([riskLevel])
  @@index([category])
  @@index([isDemo])
}

model ReputationScore {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overall       Float
  sentiment     Float?
  aiVisibility  Float?
  volume        Float?
  authority     Float?
  innovationScore Float?
  innovationWeight Float?
  performanceScore Float?
  performanceWeight Float?
  purposeScore  Float?
  purposeWeight Float?
  shareOfVoice  Float?
  trend         String?
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo        Boolean  @default(false)

  @@index([companyId, calculatedAt])
  @@index([isDemo])
}

model AIVisibility {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      String
  cited         Boolean
  position      String?
  sentiment     String?
  confidence    Float?
  summary       String?
  checkedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  // ─── REAL AI PROBING (Task: ai-visibility-real) ───────────────
  // One row per (engine × probe query). A single probe run produces
  // 10 queries × 8 engines = 80 rows grouped by `batchId`.
  query           String?  // The probe query that was sent to the engine
  rank            Int?     // 1-based position where the company was first mentioned (null when not mentioned)
  mentions        Int?     // Count of company-name occurrences in the response
  shareOfVoice    Float?   // 0-100 — share of the response that is about this company
  simulated       Boolean  @default(false) // true when the engine is simulated via prompt variation (labeled in UI)
  responseExcerpt String?  // Short excerpt (~240 chars) of the LLM response
  sentimentScore  Float?   // -1 (very negative) to 1 (very positive)
  batchId         String?  // Groups all 80 rows from a single probe run (cuid-based)

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  // isDemo: true when this row was created by the executive demo seed.
  // The Brand Monitor demo seeds 8 AIVisibility rows on the first
  // (real) company; without this flag, a real user attached to that
  // same company would see the demo citations as if they were real.
  isDemo          Boolean  @default(false)

  @@index([companyId, platform])
  @@index([companyId, checkedAt])
  @@index([companyId, batchId])
  @@index([batchId, platform])
  @@index([isDemo])
}

// ─── ENTITY GRAPH ───────────────────────────────────────────────

model Entity {
  id            String   @id @default(cuid())
  entityType    String
  name          String
  aliases       String[]
  confidence    Float    @default(0.5)
  firstSeen     DateTime @default(now())
  lastSeen      DateTime @default(now())
  sources       String[]
  tags          String[]
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  mentions      EntityMention[]

  @@index([entityType])
  @@index([name])
}

model EntityMention {
  id            String   @id @default(cuid())
  entityId      String
  entity        Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  articleId     String?
  mentionText   String
  sentimentLabel String?
  sentimentScore Float?
  mentionedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([entityId])
  @@index([companyId])
}

// ─── GLM CACHE (24h TTL strict) ─────────────────────────────────

model GLMAnalysis {
  id            String   @id @default(cuid())
  inputHash     String   @unique
  model         String
  promptType    String
  inputPayload  Json
  outputPayload Json
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  @@index([inputHash])
  @@index([promptType])
  @@index([createdAt])
}

// ─── JOBS & LOGGING ─────────────────────────────────────────────

model Job {
  id            String   @id @default(cuid())
  jobType       String
  status        String   @default("pending")
  payload       Json?
  result        Json?
  error         String?
  progress      Int      @default(0)
  scheduledAt   DateTime @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([jobType, status])
  @@index([status])
}

model ScraperLog {
  id            String   @id @default(cuid())
  sourceId      String
  sourceName    String
  sourceUrl     String
  status        String
  articlesFound Int      @default(0)
  articlesNew   Int      @default(0)
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([sourceId, startedAt])
  @@index([status])
}

model SystemLog {
  id            String   @id @default(cuid())
  level         String
  category      String
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([level, createdAt])
  @@index([category])
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  action        String
  resource      String
  ipAddress     String?
  userAgent     String?
  result        String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ─── Task: YGGDRASIL-N35 — SuperAdmin Audit Trail ──────────────
// Immutable, tamper-evident audit log for super_admin actions.
// Each entry chains to the previous one via prevHash (SHA-256 of
// the previous entry's hash). Deleting or modifying any entry
// breaks the chain → tamper is detected immediately.
model SuperAdminAudit {
  id            String   @id @default(cuid())
  userId        String   // the super_admin who performed the action
  userEmail     String   // denormalized for query speed
  action        String   // master_code_generate | session_revoked | role_changed | etc.
  resource      String   // what was acted upon (user:xxx, company:xxx)
  result        String   // success | denied | error
  ipAddress     String?
  userAgent     String?
  metadata      Json?
  entryHash     String   @unique  // SHA-256 of (prevHash + userId + action + resource + timestamp)
  prevHash      String?  // hash of the previous entry (null for the first)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@index([createdAt])
}

// ─── Task: WIRE-UI-PROV — Provenance Record (Palantir-grade evidence chain) ──
// Every computed score in HarchIQ (SentimentScore, CrisisScore, ReputationScore,
// ArticleSentiment, …) is traceable to its source data, computation engine,
// model version, and confidence interval. Replaces the in-memory store in
// src/lib/provenance/tracker.ts with a durable Neon-backed table.
model ProvenanceRecord {
  id              String   @id @default(cuid())
  entityType      String   // SentimentScore | CrisisScore | ArticleSentiment | etc.
  entityId        String
  companyId       String
  sourceArticleIds String[] // array of Article IDs
  engine          String   // lexicon | glm | bayesian | crisis-detector
  modelVersion    String   // e.g. "glm-4", "lexicon-v3"
  inputParams     Json?
  outputSnapshot  Json?
  confidence      Float    @default(1.0)
  computedBy      String   @default("system")
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId, createdAt])
  @@index([engine])
}

// ─── Task: YGGDRASIL-N38 — System Flags (DEFCON) ──────────────
// Key-value store for system-wide flags (defcon_level, tamper_incident,
// maintenance_mode). The Sentinel cron sets defcon_level=1 when the
// audit chain is broken — super_admin UI reads it to trigger lockdown.
model SystemFlag {
  key       String   @id  // "defcon_level" | "tamper_incident" | "maintenance_mode"
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ─── AUTH ───────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  role          String   @default("user")        // user | admin | company-admin
  accountType   String   @default("brand-monitor") // brand-monitor | market-competitor | investment-bank | harch-alpha (ISOLATED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── Task: company-dedup-enterprise-admin ───────────────────────────
  // companyId: the company this user belongs to (null for super-admins
  // and users not yet linked to a company). company-admin role implies
  // companyId is non-null — enforced at the API layer, not the DB.
  // status: active | suspended (a company-admin can suspend a member).
  // lastLoginAt: best-effort timestamp updated on each successful
  // credentials sign-in (used by the enterprise team list).
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status        String   @default("active") // active | suspended
  lastLoginAt   DateTime?

  // ─── Task: user-company-onboarding ─────────────────────────────────
  // jobTitle: free-form role at the company (Dircom, CRO, Analyst, ...).
  // onboardingCompleted: false until the user finishes the 4-step wizard
  // at /atelier/onboarding. Console APIs hard-403 if this is false and
  // the user has no companyId — preventing the "every user sees OCP"
  // leak that the old findFirst() fallback caused.
  // topics / competitors / trackedAssets: lightweight JSON prefs captured
  // during onboarding step 3 (per accountType). Stored on the user row
  // so the dashboards can pre-filter without an extra join.
  jobTitle              String?
  onboardingCompleted   Boolean  @default(false)
  topics                String[]  @default([])
  competitors           String[]  @default([])
  trackedAssets         String[]  @default([])
  useCaseNote           String?

  // ─── WhatsApp alerts (Twilio) ────────────────────────────────────
  // whatsappNumber: E.164 format phone (e.g. +212600000000). NULL = unset.
  // whatsappAlerts: master toggle for the user.
  // alertSeverityThreshold: minimum severity that triggers a WhatsApp push.
  whatsappNumber          String?  // E.164 format: +212600000000
  whatsappAlerts          Boolean  @default(false)
  alertSeverityThreshold  String   @default("high") // low | medium | high | critical

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  // isDemo: true for the four executive demo accounts
  // (demo-brand-monitor@, demo-market-competitor@, demo-investment-bank@,
  // demo-harch-alpha@harch.atelier). Demo users see ONLY isDemo:true
  // data; real users see ONLY isDemo:false data. The flag is also
  // surfaced in the JWT session so the company-session helper can
  // build the demoFilter without an extra DB round-trip per request.
  isDemo                  Boolean  @default(false)

  sessions      Session[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  accounts      Account[]
  portfolios    Portfolio[]
  dossiers      Dossier[]
  reports       Report[]
  briefings     Briefing[]
  invitations   Invitation[] @relation("InvitationCreator")

  // ─── Agency white-label relation (Brique 8) ───────────────────
  // Users with role="agency-admin" are linked to an Agency master account.
  // They can switch between sub-client workspaces via activeAgencyClientId.
  agency         Agency?  @relation("AgencyAdmins", fields: [agencyId], references: [id], onDelete: SetNull)
  agencyId       String?

  // ─── Task: YGGDRASIL-N40 — Session Revocation ──────────────────
  // sessionVersion: bumped by admin to invalidate ALL existing JWTs for
  // this user. The JWT callback checks token.sessionVersion against the
  // DB value — if they differ, the token is rejected (user must re-sign-in).
  // This gives real-time revocation without a Redis blacklist.
  sessionVersion  Int  @default(0)

  @@index([companyId])
  @@index([status])
  @@index([isDemo])
  @@index([agencyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken  String   @unique
  expires       DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([expires])
}

model ApiKey {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash       String   @unique
  name          String
  tier          String   @default("pro")
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())

  // ─── Task: signal-enterprise-platform ────────────────────────────────
  // keyPrefix: first 12 chars of the plaintext key (e.g. "harch_ab12cd34").
  // Stored unhashed so the API-key management UI can show a recognisable
  // suffix next to each key (like GitHub's "last used" tokens list) without
  // ever exposing the full secret. The full secret is only shown ONCE at
  // creation time.
  keyPrefix     String?
  // revokedAt: set when the user clicks "Revoke". Soft-delete so audit
  // logs that reference the key id stay intact. authenticateApiKey()
  // rejects any key with revokedAt != null.
  revokedAt     DateTime?

  webhooks      Webhook[]

  @@index([userId])
  @@index([keyHash])
}

// ─── WEBHOOKS (Task: signal-enterprise-platform) ─────────────────────
// Registered by company admins to receive outbound POST callbacks when
// critical/high alerts fire, reports become ready, or other subscribed
// events occur. Dispatched by src/lib/harchiq/webhook-dispatcher.ts.
//
// A Webhook is owned by a User (and transitively a Company). The
// dispatcher filters webhooks by companyId so a single alert fans out
// to every endpoint registered for that company.
//
// `events` is a JSON-encoded string array because Prisma on Neon does
// not allow scalar list columns in the schema policy we follow. The
// dispatcher parses it via JSON.parse before matching.
//
// `secret` is an optional HMAC signing secret the client can verify on
// receipt (X-Harch-Signature = hex(HMAC-SHA256(secret, body))). When
// null, the request is unsigned.

model Webhook {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  url           String
  events        String   @default("[]")   // JSON array: ["alert.critical","alert.high","report.ready"]
  secret        String?                     // optional HMAC signing secret
  description   String?
  isActive      Boolean  @default(true)
  lastDeliveryAt DateTime?
  lastDeliveryStatus String?               // success | failed | pending
  lastDeliveryMessage String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // The API key used to register the webhook (provenance / audit).
  apiKeyId      String?
  apiKey        ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  deliveries    WebhookDelivery[]

  @@index([userId])
  @@index([companyId])
  @@index([isActive])
}

// ─── WEBHOOK DELIVERY LOG ────────────────────────────────────────────
// One row per delivery attempt. The dispatcher writes one row per
// retry so the admin UI can show the full delivery history per
// webhook (success/failure timeline, latency, response status).

model WebhookDelivery {
  id            String   @id @default(cuid())
  webhookId     String
  webhook       Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String                       // e.g. "alert.critical"
  payload       String                       // JSON string of the body sent
  attempt       Int                          // 1, 2, 3 (retry number)
  status        String   @default("pending") // pending | success | failed
  httpStatus    Int?
  responseSnippet String?                    // first 500 chars of the response body (debug)
  errorMessage  String?
  durationMs    Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([webhookId, startedAt])
  @@index([status])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ACCESS REQUESTS (public form submissions) ──────────────────
// People who want access to the Console fill a public form.
// Admin reviews and creates invitations from these requests.

model AccessRequest {
  id            String   @id @default(cuid())
  email         String
  name          String
  company       String?
  role          String?
  accountType   String?  @default("brand-monitor") // brand-monitor | market-competitor | investment-bank | harch-alpha
  companySize   String?  // startup | sme | mid-market | enterprise
  useCase       String?  // what they want to monitor
  budget        String?  // monthly budget range
  phone         String?  // for WhatsApp
  country       String?  // default: Morocco
  referralSource String? // how they heard about us
  message       String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invitationId String?
  invitation   Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

// ─── INVITATIONS (admin-created access links) ───────────────────
// Admin creates an invitation with a pre-set password.
// The invitation link is sent to the user. When they visit it,
// they see their pre-filled info and can sign in immediately.

model Invitation {
  id            String    @id @default(cuid())
  token         String    @unique  // URL token for /atelier/access?token=XXX
  email         String
  name          String
  passwordHash  String    // bcrypt hash of admin-generated password (NEVER plaintext)
  accountType   String    @default("brand-monitor")  // brand-monitor | market-competitor | investment-bank | harch-alpha
  role          String    @default("user")        // user | admin | company-admin
  company       String?
  message       String?   // optional personal message from admin
  createdById   String?
  createdBy     User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  usedAt        DateTime?  // null until user accepts
  acceptedById  String?  // the User.id created from this invitation

  // ─── Task: company-dedup-enterprise-admin ─────────────────────────
  // companyId: the company this invitation is scoped to. When a
  // company-admin invites a teammate, this is set to their own
  // companyId so the new user is automatically attached to the same
  // company on activation. Super-admins can leave it null.
  companyId     String?
  companyRef    Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  accessRequests AccessRequest[]

  @@index([token])
  @@index([email])
  @@index([createdAt])
  @@index([companyId])
}

// ─── TRADER MODELS (Asset, AssetPrice, AssetSentiment) ──────────
// Traders monitor ASSETS (stocks, crypto, commodities, FX), not
// companies. The same Article pipeline feeds both: an article about
// OCP feeds Company.reputationScore (enterprise) AND Asset.sentiment
// (trader) via the company.ticker → Asset.ticker link.

model Asset {
  id          String   @id @default(cuid())
  ticker      String   @unique  // e.g. "OCP", "ATW", "IAM", "BTC", "EURUSD"
  name        String
  assetType   String   // stock | crypto | commodity | fx | index
  exchange    String?  // e.g. "BVC" (Bourse de Casablanca), "BINANCE"
  companyId   String?  // link to Company if asset is a listed stock
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices      AssetPrice[]
  sentiments  AssetSentiment[]
  portfolioHoldings PortfolioHolding[]

  @@index([assetType])
  @@index([exchange])
}

model AssetPrice {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  price       Float
  volume      Float?
  changePct   Float?   // % change vs previous close
  tradedAt    DateTime
  createdAt   DateTime @default(now())

  @@index([assetId, tradedAt])
}

model AssetSentiment {
  id            String   @id @default(cuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  score         Float    // -1 to 1 (sentiment)
  positivePct   Float
  neutralPct    Float
  negativePct   Float
  articleCount  Int
  calculatedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([assetId, calculatedAt])
}

// ─── INVESTOR MODELS (Portfolio, PortfolioHolding, Dossier) ─────
// Investors track multiple PORTFOLIOS of companies/assets and run
// due diligence DOSSIERS on targets. ESG + Controversy screening
// is built on top of RiskAssessment (already exists).

model Portfolio {
  id          String   @id @default(cuid())
  name        String   // e.g. "Fund VI", "ESG Fund", "Co-invest Pool"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo      Boolean  @default(false)

  holdings    PortfolioHolding[]

  @@index([userId])
  @@index([isDemo])
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  companyId   String?  // optional link to Company
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assetId     String?  // optional link to Asset
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  weight      Float    // portfolio weight (0-1)
  addedAt     DateTime @default(now())

  @@index([portfolioId])
}

model Dossier {
  id          String   @id @default(cuid())
  title       String   // e.g. "OCP Group — DD Q3 2026"
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?  // the target company being investigated
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  status      String   @default("draft")  // draft | generating | ready | archived
  pdfUrl      String?  // generated PDF URL
  pageCount   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo      Boolean  @default(false)

  @@index([userId])
  @@index([status])
  @@index([isDemo])
}

// ─── MONTHLY REPORTS (PDF) ──────────────────────────────────────
// Generated on the 1st of each month by /api/cron/generate-reports.
// `sections` is a JSON blob with the structured data that feeds the
// ReportPDF document (executive summary, sentiment, AI visibility,
// alerts log, recommendations). One Report per (userId, period).

model Report {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?  // optional link to the primary Company the report covers
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title       String   // e.g. "Monthly Intelligence Report"
  period      String   // e.g. "2026-07" (YYYY-MM)
  summary     String   // 1-2 paragraph executive summary
  sections    Json     // structured data: { metrics, alerts, aiEngines, recommendations, sentimentTrend, sources }
  status      String   @default("ready")  // draft | generating | ready | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, period])
  @@index([userId, createdAt])
  @@index([period])
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────
// Per-user notifications generated by cron jobs (alert scanner,
// report generator, threshold breaches) and surfaced in the
// ConsoleShell top-bar bell dropdown.

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // alert | report | system | threshold
  title     String
  body      String
  severity  String   @default("info") // info | warning | critical
  read      Boolean  @default(false)
  link      String?  // URL to navigate to
  createdAt DateTime @default(now())

  // ─── Task: domain-matching-demo-isolation ──────────────────────────
  isDemo    Boolean  @default(false)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([isDemo])
}

// ─── DAILY AI BRIEFINGS ───────────────────────────────────────────
// Generated each morning by /api/cron/generate-briefings (07:00 UTC).
// One row per (userId, date). The LLM is prompted with the last 24h of
// alerts/topics/ai-visibility/neighbors and returns a structured
// briefing with cited REAL alert IDs (no hallucinated sources — the
// API maps the LLM's alertIndex back to actual Article/RiskAssessment
// ids before persisting). The Console fetches the cached row by date
// and falls back to on-demand generation if missing.
//
// `sections` JSON shape mirrors what the /api/console/briefing route
// returns on the wire:
//   {
//     executiveSummary: string,
//     topThreats:       [{ title, alertId, alertIndex, reason, source, url, severity }],
//     topOpportunities: [{ title, alertId, alertIndex, reason, source, url, severity }],
//     sentimentShift:   string,
//     recommendedActions: string[],
//     citedAlertIds:    string[],
//     sources:          [{ id, title, source, url, severity, publishedAt }]
//   }

model Briefing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  date        String   // YYYY-MM-DD (Casablanca local day the briefing covers)
  title       String   // e.g. "Daily Intelligence Briefing — 2026-07-31"
  summary     String   // 2-3 sentence executive summary (also stored in sections.executiveSummary)
  sections    Json     // structured briefing payload (see comment above)
  model       String?  // LLM model used (e.g. "glm-4")
  alertCount  Int      // number of alerts fed to the LLM
  citedCount  Int      // number of real alerts cited
  status      String   @default("ready") // draft | generating | ready | failed
  error       String?  // populated when status = "failed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, createdAt])
  @@index([date])
}

// ─── INFLUENCER DATABASE (Klear / Meltwater-style) ────────────────
// Curated directory of Moroccan journalists, editors, analysts and
// content creators across press / Twitter-X / LinkedIn / YouTube /
// TikTok / Instagram. Each profile carries composite influence
// metrics (reach / engagement / authority) plus a 30-day mention
// history (InfluencerMention) — surfaced in the Brand Monitor
// console under "Influencers DB".

model Influencer {
  id              String   @id @default(cuid())
  name            String
  handle          String?  // @username on the platform
  platform        String   // twitter | linkedin | instagram | youtube | tiktok | press
  bio             String?
  followers       Int      @default(0)
  following       Int      @default(0)
  verified        Boolean  @default(false)
  location        String?  // Casablanca, Rabat, etc.
  languages       String   @default("[]") // JSON array of language codes
  topics          String   @default("[]") // JSON array of topic labels
  reachScore      Int      @default(0)    // 0-100
  engagementScore Int      @default(0)    // 0-100
  authorityScore  Int      @default(0)    // 0-100
  influenceScore  Int      @default(0)    // composite 0-100
  lastAnalyzed    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mentions        InfluencerMention[]

  @@index([platform, influenceScore])
  @@index([location])
}

model InfluencerMention {
  id           String   @id @default(cuid())
  influencerId String
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  alertId      String?  // link to the alert/article if applicable
  title        String
  url          String?
  sentiment    String   @default("neutral") // positive | neutral | negative
  reach        Int      @default(0)
  publishedAt  DateTime
  createdAt    DateTime @default(now())

  @@index([influencerId, publishedAt])
}

// ─── SANCTIONS LISTS CACHE (real OFAC/EU/UN screening) ────────────
// Parsed sanctions entries are persisted here by the daily cron
// (/api/cron/refresh-sanctions at 03:00 UTC) and served to
// /api/investor/screen on every screening request. Each row holds the
// full parsed list as a JSON string (`data`) plus a denormalized
// `entryCount` for quick capacity reporting. The cache is treated as
// stale after 24h — if a screening request hits a stale row, the route
// triggers a background refresh and serves the stale data meanwhile.
// If a fresh download fails, the route logs a warning and falls back
// to the last successful cache (NEVER serves an empty list silently).

model SanctionsCache {
  id            String   @id @default(cuid())
  list          String   @unique // "OFAC" | "EU" | "UN"
  data          String   // JSON string of SanctionsEntry[]
  entryCount    Int
  downloadedAt  DateTime
  sourceUrl     String?  // URL the data was fetched from (for audit)
  byteSize      Int?     // raw payload size in bytes (for telemetry)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([list, downloadedAt])
}

// ─── COMPANY SETTINGS (Task: company-dedup-enterprise-admin) ────────
// Per-company configuration managed by the company-admin role.
// One row per Company (1:1). The `topics`, `competitors` and
// `alertThresholds` fields are JSON-encoded arrays/objects so they
// can evolve without a schema migration:
//   - topics:           ["OCP", "phosphate prices", "ESG"]
//   - competitors:      ["Competitor A", "Competitor B"]
//   - alertThresholds:  { sentimentDrop: -0.3, riskLevel: "high", minMentions: 5 }
//   - monitoredSources: ["lematin.ma", "hespress.com", ...]
// A row is lazily created the first time a company-admin saves any
// setting. GET returns sensible defaults if no row exists yet.

model CompanySettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  topics            String   @default("[]")  // JSON array of topic labels
  competitors       String   @default("[]")  // JSON array of competitor names/slugs
  monitoredSources  String   @default("[]")  // JSON array of source URLs/domains
  alertThresholds   String   @default("{}")  // JSON object { sentimentDrop, riskLevel, minMentions }
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
}

// ═══ MULTI-TENANT ISOLATION (Master Spec Sheet — LOOP 2) ═════════
// Tenant = the customer company that owns the tracked entities.
// Enables hard multi-tenant isolation via RLS-style filtering.

model Tenant {
  id          String   @id @default(cuid())
  name        String                              // "OCP Group" (the customer)
  plan        String   @default("starter")        // starter | pro | enterprise
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isDemo])
}

// ═══ ALERT ENGINE (Master Spec Sheet — real-time alerts) ════════
// Stores triggered alerts from the alert engine (threshold breaches,
// sentiment drops, risk events). Feeds the notification dispatcher.

model Alert {
  id              String   @id @default(cuid())
  tenantId        String?
  type            String                                 // sentiment_drop | risk_breach | volume_spike | ai_visibility | regulatory
  severity        String                                 // info | low | medium | high | critical
  title           String
  body            String
  companyId       String?
  articleId       String?
  threshold       String?                                // JSON: {metric, operator, value}
  triggeredAt     DateTime @default(now())
  acknowledgedAt  DateTime?
  acknowledgedBy  String?

  @@index([tenantId, triggeredAt])
  @@index([severity, triggeredAt])
  @@index([companyId])
}

// ═══ MASTER CODES ADMIN (Project YGGDRASIL — super_admin activation) ══
// One-time-use secret codes that promote a regular user to super_admin.
// The plaintext code is NEVER stored — only SHA-256(salt + code).
// Each code:
//   - expires 24h after creation (expiresAt)
//   - can be consumed exactly once (usedAt + usedByUserId set on success)
//   - is generated by an existing super_admin (createdBy = userId),
//     EXCEPT the very first bootstrap code, where createdBy = "bootstrap".
// Validation is constant-time (timingSafeEqual on the hash) and
// gate-kept by an IP rate-limiter (5 attempts / 10 min) at the API layer.

model MasterCode {
  id           String    @id @default(cuid())
  codeHash     String    @unique   // SHA-256(salt + ":" + code) hex digest
  codeSalt     String              // 32-byte random salt (hex, 64 chars)
  createdBy    String              // userId of the super_admin who generated it ("bootstrap" for first code)
  usedAt       DateTime?           // null = available, non-null = consumed
  usedByUserId String?             // userId of the user who consumed the code
  expiresAt    DateTime            // TTL = createdAt + 24h
  createdAt    DateTime  @default(now())

  @@index([codeHash])
  @@index([usedAt])
  @@index([expiresAt])
}
